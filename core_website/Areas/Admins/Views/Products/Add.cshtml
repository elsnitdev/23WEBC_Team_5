@* // KhoaTr - 10/16/2025: Refactored image upload with hidden previews until upload, balanced columns *@
@using core_website.Models
@model SanPhamFormViewModel
@{
    ViewData["PageTitle"] = "Thêm Sản Phẩm Mới";
}
<div class="container mt-4">
    @if (!string.IsNullOrEmpty(Model?.MessageType) && !string.IsNullOrEmpty(Model?.Message))
    {
        <div class="@(Model.MessageType == "Success" ? "alert-success" : "alert-danger")" id="formMessage">
            @Model.Message
        </div>
    }
    <form asp-area="Admins" asp-controller="Products" asp-action="Create" enctype="multipart/form-data" id="productForm">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="TenSP" class="control-label"></label>
                    <input asp-for="TenSP" class="form-control" placeholder="Nhập tên sản phẩm" />
                    <span asp-validation-for="TenSP" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="DonGia" class="control-label"></label>
                    <input asp-for="DonGia" class="form-control" type="number" step="0.01" min="0" placeholder="Nhập đơn giá (VNĐ)" />
                    <span asp-validation-for="DonGia" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="KhuyenMai" class="control-label"></label>
                    <input asp-for="KhuyenMai" class="form-control" type="number" step="0.01" min="0" placeholder="Nhập giá khuyến mãi (VNĐ, nếu có)" />
                    <span asp-validation-for="KhuyenMai" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="SoLuong" class="control-label"></label>
                    <input asp-for="SoLuong" class="form-control" type="number" min="0" placeholder="Nhập số lượng" />
                    <span asp-validation-for="SoLuong" class="text-danger"></span>
                </div>
                @* <div class="form-group mb-3">
                    <label asp-for="Tag" class="control-label"></label>
                    <input asp-for="Tag" class="form-control" placeholder="Nhập tag (ví dụ: điện tử, laptop, mới)" />
                    <span asp-validation-for="Tag" class="text-danger"></span>
                </div> *@
            </div>
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="MaDM" class="control-label">Danh Mục</label>
                    <div style="display:flex;gap:4px">
                        <select asp-for="MaDM" class="form-control" asp-items="@Model.DanhMucList">
                            <option value="">-- Chọn danh mục --</option>
                        </select>
                        <button style="width:fit-content" type="button" class="btn btn-primary" data-toggle="modal" data-target="#AddNewDanhMucModal">
                            + Thêm Danh Mục
                        </button>
                    </div>
                    <span asp-validation-for="MaDM" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="MoTa" class="control-label"></label>
                    <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Nhập mô tả sản phẩm"></textarea>
                    <span asp-validation-for="MoTa" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="ThongSo" class="control-label"></label>
                    <textarea asp-for="ThongSo" class="form-control" rows="3" placeholder="Nhập thông số kỹ thuật"></textarea>
                    <span asp-validation-for="ThongSo" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="Thumbnail" class="control-label"></label>
                    <div class="image-preview"
                         style="width: 200px; height: 200px; border: 1px solid #ddd; margin-bottom: 10px; display: none; align-items: center; justify-content: center; background: #f8f8f8; overflow: hidden;">
                    </div>
                    <input asp-for="Thumbnail" type="file" class="form-control" accept="image/png,image/jpeg,image/gif" />
                    <span asp-validation-for="Thumbnail" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="HinhAnhChiTiet" class="control-label"></label>
                    <div class="image-preview"
                         style="width: 200px; height: 200px; border: 1px solid #ddd; margin-bottom: 10px; display: none; align-items: center; justify-content: center; background: #f8f8f8; overflow: hidden;">
                    </div>
                    <input asp-for="HinhAnhChiTiet" type="file" class="form-control" accept="image/png,image/jpeg,image/gif" multiple />
                    <span asp-validation-for="HinhAnhChiTiet" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="form-group mt-3">
            <button type="submit" class="btn btn-primary">Thêm Sản Phẩm</button>
            <a asp-action="Index" asp-controller="Products" asp-area="Admins" class="btn btn-secondary">Hủy</a>
        </div>
    </form>
    @* Modal thêm danh mục mới *@
    <div class="modal fade" id="AddNewDanhMucModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="myModalLabel">Thêm danh mục mới</h4>
                </div>
                <div class="modal-body">
                    <input asp-for="NewTenDM" id="NewTenDMInput" class="form-control" placeholder="Nhập tên danh mục mới" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button id="AddNewDanhMucBtn" type="button" class="btn btn-primary">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            // Disable select if NewTenDM has data
            $('#NewTenDM').on('input', function () {
                if ($(this).val().trim() !== '') {
                    $('#MaDM').val('');
                    $('#MaDM').prop('disabled', true);
                } else {
                    $('#MaDM').prop('disabled', false);
                }
            });
            // Disable NewTenDM input if a category is selected
            $('#MaDM').on('change', function () {
                if ($(this).val()) {
                    $('#NewTenDM').val('');
                    $('#NewTenDM').prop('disabled', true);
                } else {
                    $('#NewTenDM').prop('disabled', false);
                }
            });
            // Xử lý sự kiên thêm danh mục mới
            $("#AddNewDanhMucBtn").on("click", function () {
                const NewDanhMuc = $("#NewTenDMInput").val();
                $.ajax({
                    url: '/api/Categories',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ TenDM: NewDanhMuc }),
                    success: function (response) {
                        // Thêm vào select
                        $('#DanhMucSelect').append($('<option>', {
                            value: response.value,
                            text: response.text
                        }));
                        // Dọn input và đóng modal
                        $('#NewDanhMucName').val('');
                        $('#AddNewDanhMucModal').modal('hide');
                        alert('Thêm danh mục thành công!');
                    },
                    error: function (xhr, status, error) {
                        alert(`Lỗi khi thêm danh mục mới (${xhr.responseText})`);
                    }
                })
            })
            // Hàm tạo container và in hình vào trong container đó
            function handleImagePreview(event, previewSize) {
                const files = event.target.files;
                const $previewContainer = $(event.target).prev('.image-preview');
                $previewContainer.empty();
                if (files.length === 0) {
                    $previewContainer.hide();
                    return;
                }
                if (files.length > 1) {
                    $previewContainer.css({
                        'display': 'flex',
                        'flex-wrap': 'wrap',
                        'gap': '10px',
                        'width': 'auto',
                        'height': 'auto',
                        'padding': '5px'
                    }).show();
                } else {
                    $previewContainer.css({
                        'display': 'flex',
                        'flex-wrap': 'nowrap',
                        'gap': '0',
                        'width': `${previewSize}px`,
                        'height': `${previewSize}px`,
                        'padding': '0'
                    }).show();
                }
                Array.from(files).forEach(file => {
                    const reader = new FileReader();
                    const $imageWrapper = $('<div>').css({
                        'width': `${previewSize}px`,
                        'height': `${previewSize}px`,
                        'border': '1px solid #ddd',
                        'display': 'flex',
                        'align-items': 'center',
                        'justify-content': 'center',
                        'background': '#f8f8f8',
                        'overflow': 'hidden'
                    });
                    reader.onload = function (e) {
                        const $img = $('<img>').attr('src', e.target.result).css({
                            'width': '100%',
                            'height': '100%',
                            'object-fit': 'contain'
                        });
                        $imageWrapper.html($img);
                        $previewContainer.append($imageWrapper);
                    };
                    reader.readAsDataURL(file);
                });
            }
            // Xử lý upload hình tạo preview
            $('input[type="file"]').on('change', function (e) {
                handleImagePreview(e, 200);
            });
        });
    </script>
}
@* // KhoaTr - END *@